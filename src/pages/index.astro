---
// Front page. Text blocks are near the top of this file so they are easy to edit.
import Base from '../layouts/Base.astro';
import IonHop from '../components/IonHop.astro';
import Figure from '../components/Figure.astro';
import PaperItem from '../components/PaperItem.astro';
import { getCollection, render } from 'astro:content';
import { getPapers } from '../lib/papers';
import { monthYear } from '../lib/format';
import { site } from '../data/site';

const intro = 'We use machine learning and atomistic simulation to find out how ions move in solids, polymers, and liquids, and use that understanding to design materials for batteries.';

const areas = (await getCollection('research')).sort((a, b) => a.data.order - b.data.order);
const papers = getPapers().filter((p) => !p.underReview).slice(0, 5);
const news = (await getCollection('news', (n) => !n.data.draft)).sort((a, b) => +b.data.date - +a.data.date).slice(0, 5);
const newsBodies = await Promise.all(news.map(async (n) => ({ n, C: (await render(n)).Content })));
const roleOrder = ['pi', 'postdoc', 'phd', 'ms', 'visiting', 'ug'];
const members = (await getCollection('people', (p) => p.data.role !== 'alumni'))
  .sort((a, b) => roleOrder.indexOf(a.data.role) - roleOrder.indexOf(b.data.role) || a.data.order - b.data.order);
---
<Base>
  <div class="wrap">
    <section class="hero">
      <div class="hero-text">
        <span class="label">{site.fullName}</span>
        <h1>MINDS Lab</h1>
        <p class="lead">{intro}</p>
        <p class="aff">{site.units.join(' · ')}, {site.university}</p>
        <div class="hero-actions">
          <a class="btn primary" href="/research/">Research</a>
          <a class="btn" href="/publications/">Publications</a>
          <a class="btn" href="/join/">Join the lab</a>
        </div>
      </div>
      <IonHop height={380} />
    </section>

    <section>
      <div class="sec-head"><h2>Research areas</h2><a href="/research/">All research →</a></div>
      <div class="areas">
        {areas.map((a, i) => (
          <a class="area panel" href={`/research/#${a.id}`}>
            <Figure name={a.data.figure} image={a.data.image} alt={a.data.title} />
            <span class="label">{String(i + 1).padStart(2, '0')}</span>
            <h3>{a.data.title}</h3>
            <p>{a.data.question}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="two-col">
      <div>
        <div class="sec-head"><h2>Recent publications</h2><a href="/publications/">All →</a></div>
        <div>{papers.map((p) => <PaperItem paper={p} showBib={false} />)}</div>
      </div>
      <div>
        <div class="sec-head"><h2>News</h2><a href="/news/">All →</a></div>
        <div class="news-list">
          {newsBodies.map(({ n, C }) => (
            <div class="news-item compact">
              <time datetime={n.data.date.toISOString()}>{monthYear(n.data.date)}</time>
              <div class="nbody">{n.data.title ? <h3>{n.data.title}</h3> : <div class="prose"><C /></div>}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section>
      <div class="sec-head"><h2>People</h2><a href="/people/">All members and alumni →</a></div>
      <div class="strip">
        {members.map((m) => (
          <a class="mini" href="/people/">
            {m.data.photo ? <img src={`/img/people/${m.data.photo}`} alt="" loading="lazy" /> : <span class="ph" />}
            <span class="mname">{m.data.name}</span>
            <span class="mrole">{m.data.title}</span>
          </a>
        ))}
      </div>
    </section>

    <section class="recruit panel">
      <div>
        <h2>Open positions</h2>
        <p>We are recruiting M.S. and Ph.D. students, undergraduate researchers, and postdocs. Students from mechanical engineering, materials science, chemical engineering, physics, chemistry, energy engineering, and related fields are welcome.</p>
      </div>
      <div lang="ko">
        <h2>연구실 모집</h2>
        <p>석·박사과정 대학원생, 학부 연구 인턴, 박사후연구원을 모집합니다. 기계공학, 신소재공학, 화학공학, 물리학, 화학, 에너지공학 등 다양한 배경의 학생을 환영합니다.</p>
      </div>
      <div class="recruit-actions">
        <a class="btn primary" href="/join/">Details / 자세히 보기</a>
        <span class="label">Contact: {site.email}</span>
      </div>
    </section>
  </div>
</Base>

<style>
  .hero { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); gap: 40px; align-items: center; padding-block: 52px 8px; }
  .hero-text { display: flex; flex-direction: column; gap: 14px; }
  .hero h1 { font-size: clamp(40px, 6vw, 64px); font-weight: 800; letter-spacing: -.03em; line-height: 1; }
  .lead { font-size: 19px; line-height: 1.6; color: var(--ink); max-width: 38ch; }
  .aff { color: var(--ink-2); font-size: 15px; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 6px; }
  @media (max-width: 860px) { .hero { grid-template-columns: 1fr; gap: 24px; padding-top: 32px; } }

  .areas { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 16px; }
  .area { display: flex; flex-direction: column; gap: 8px; padding: 12px 12px 16px; text-decoration: none; color: var(--ink); transition: border-color .15s; }
  .area:hover { border-color: var(--amber); }
  .area h3 { font-size: 16px; font-weight: 700; }
  .area p { font-size: 14px; color: var(--ink-2); line-height: 1.55; }
  .area .label { margin-top: 4px; }

  .two-col { display: grid; grid-template-columns: 1.35fr 1fr; gap: 40px; }
  @media (max-width: 860px) { .two-col { grid-template-columns: 1fr; } }
  .news-item.compact { grid-template-columns: 80px 1fr; padding-block: 12px; }
  .news-item.compact h3 { font-size: 15px; font-weight: 600; }
  .news-item.compact .prose { font-size: 15px; }

  .strip { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 16px; }
  .mini { display: flex; flex-direction: column; gap: 4px; text-decoration: none; color: var(--ink); }
  .mini img, .mini .ph { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: top; border-radius: 8px; background: var(--line); }
  .mname { font-weight: 700; font-size: 15px; margin-top: 4px; }
  .mrole { font-size: 13px; color: var(--ink-2); }

  .recruit { display: grid; grid-template-columns: 1fr 1fr; gap: 24px 40px; padding: 28px; border-left: 4px solid var(--amber); }
  .recruit h2 { font-size: 20px; margin-bottom: 8px; }
  .recruit p { color: var(--ink-2); }
  .recruit-actions { grid-column: 1 / -1; display: flex; flex-wrap: wrap; align-items: center; gap: 16px; }
  @media (max-width: 720px) { .recruit { grid-template-columns: 1fr; padding: 20px; } }
</style>
