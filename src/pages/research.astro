---
import Base from '../layouts/Base.astro';
import PaperItem from '../components/PaperItem.astro';
import { getCollection, render } from 'astro:content';
import { paperByDoiOrKey } from '../lib/papers';

const areas = (await getCollection('research')).sort((a, b) => a.data.order - b.data.order);
const items = await Promise.all(areas.map(async (a) => ({
  a,
  Content: (await render(a)).Content,
  papers: a.data.papers.map((id) => {
    const p = paperByDoiOrKey(id);
    if (!p) console.warn(`[research] paper not found in papers.bib: ${id} (area ${a.id})`);
    return p;
  }).filter(Boolean),
})));
---
<Base title="Research" description="Research areas of MINDS Lab at Korea University.">
  <div class="wrap">
    <header class="page-head">
      <h1>Research</h1>
      <p>We combine machine-learning models with atomistic simulations to understand ion transport in energy materials and to find new battery materials. The work spans inorganic crystals, amorphous solids, polymers, and liquids.</p>
      <ul class="toc">
        {areas.map((a) => <li><a href={`#${a.id}`}>{a.data.title}</a></li>)}
      </ul>
    </header>

    {items.map(({ a, Content, papers }) => (
      <section id={a.id} class={`area${a.data.image ? ' has-img' : ''}`}>
        <div class="txt">
          <h2>{a.data.title}</h2>
          <p class="q">{a.data.question}</p>
          <div class="prose"><Content /></div>
          {a.data.methods.length > 0 && (
            <div class="methods">
              <h3>Methods</h3>
              <ul>{a.data.methods.map((m) => <li>{m}</li>)}</ul>
            </div>
          )}
        </div>
        {a.data.image && <img class="fig" src={a.data.image} alt={a.data.title} loading="lazy" />}
        {papers.length > 0 && (
          <div class="rp">
            <h3>Representative papers</h3>
            {papers.map((p) => <PaperItem paper={p!} showBib={false} />)}
          </div>
        )}
      </section>
    ))}
  </div>
</Base>
<style>
  .toc { list-style: none; margin: 10px 0 0; padding: 0; display: flex; flex-direction: column; gap: 6px; }
  .toc a { font-size: 17px; font-weight: 700; }
  .area { display: grid; grid-template-columns: minmax(0, 1fr); gap: 20px; padding-top: 22px; border-top: 4px solid var(--ink); scroll-margin-top: 84px; }
  .area.has-img { grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); }
  .area.has-img .rp { grid-column: 1 / -1; }
  .fig { width: 100%; border-radius: var(--radius); }
  .txt { display: flex; flex-direction: column; gap: 14px; }
  .txt h2 { font-size: clamp(26px, 3.4vw, 36px); font-weight: 850; letter-spacing: -0.025em; }
  .q { font-size: 19px; color: var(--ink); font-weight: 600; max-width: 60ch; }
  h3 { font-size: 16px; font-weight: 800; margin-bottom: 4px; }
  .methods ul { margin: 0; padding-left: 20px; color: var(--ink-2); }
  @media (max-width: 820px) { .area.has-img { grid-template-columns: 1fr; } }
</style>
