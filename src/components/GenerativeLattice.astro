---
// Front-page animation. Atoms start as random noise and are "denoised" into a structure
// (square lattice -> hexagonal lattice -> layered -> amorphous, repeating), as in a generative model.
// While a structure is shown, Li ions (orange) hop between interstitial sites and the bonds to
// neighboring atoms light up, as when an ML potential evaluates the local environment.
// The thin orange bar at the bottom is the noise level.
const { height = 440 } = Astro.props;
---
<div class="genlat" style={`--h:${height}px`}>
  <canvas role="img" aria-label="Animation: scattered atoms are organized into a crystal with lithium ions between the lattice sites; the ions hop, then the atoms scatter again and form a different structure."></canvas>
</div>

<style>
  .genlat { position: relative; width: 100%; height: var(--h); max-height: 80vw; border-radius: var(--radius); overflow: hidden; background: var(--soft); }
  canvas { width: 100%; height: 100%; display: block; }
</style>

<script is:inline>
(function(){
  const reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let C = {};
  function readColors(){
    const cs = getComputedStyle(document.documentElement);
    const g = (k, d) => (cs.getPropertyValue(k).trim() || d);
    C = { node: g('--lattice', '#c3cad4'), edge: g('--ink-3', '#9aa3b2'), amber: g('--amber', '#f59e0b'), ink: g('--ink', '#111827') };
  }
  readColors();
  try { window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', readColors); } catch (e) {}
  const SIMS = {};
  const rnd = (a, b) => a + Math.random() * (b - a);
  const ease = t => t < 0.5 ? 4*t*t*t : 1 - Math.pow(-2*t + 2, 3) / 2;
  const clamp = (x, a, b) => Math.max(a, Math.min(b, x));
  function gauss(){ let u = 0, v = 0; while(!u) u = Math.random(); while(!v) v = Math.random(); return Math.sqrt(-2*Math.log(u))*Math.cos(2*Math.PI*v); }
  function circle(ctx, x, y, r, color, alpha){ ctx.globalAlpha = alpha == null ? 1 : alpha; ctx.fillStyle = color; ctx.beginPath(); ctx.arc(x, y, r, 0, 6.2832); ctx.fill(); ctx.globalAlpha = 1; }
  function shuffle(arr){ for(let i = arr.length - 1; i > 0; i--){ const j = (Math.random()*(i+1))|0; [arr[i], arr[j]] = [arr[j], arr[i]]; } return arr; }
  function drawEdges(ctx, pts, rc, alpha, width){
    ctx.strokeStyle = C.edge; ctx.globalAlpha = alpha; ctx.lineWidth = width || 1; ctx.beginPath();
    const rc2 = rc*rc;
    for(let i = 0; i < pts.length; i++) for(let j = i+1; j < pts.length; j++){
      const dx = pts[i].x - pts[j].x, dy = pts[i].y - pts[j].y;
      if(dx*dx + dy*dy < rc2){ ctx.moveTo(pts[i].x, pts[i].y); ctx.lineTo(pts[j].x, pts[j].y); }
    }
    ctx.stroke(); ctx.globalAlpha = 1;
  }

  // ---------- lattice generators (host positions + interstitial sites) in a W x H box ----------
  function squareLattice(W, H, a){
    const host = [], inter = [];
    const nx = Math.floor(W / a) + 1, ny = Math.floor(H / a) + 1;
    const ox = (W - (nx-1)*a)/2, oy = (H - (ny-1)*a)/2;
    for(let j = 0; j < ny; j++) for(let i = 0; i < nx; i++) host.push({ x: ox + i*a, y: oy + j*a });
    for(let j = 0; j < ny-1; j++) for(let i = 0; i < nx-1; i++) inter.push({ x: ox + (i+.5)*a, y: oy + (j+.5)*a });
    return { host, inter };
  }
  function hexLattice(W, H, a){
    const host = [], inter = [];
    const h = a*Math.sqrt(3)/2;
    const ny = Math.floor(H / h) + 1, nx = Math.floor(W / a) + 1;
    const oy = (H - (ny-1)*h)/2;
    for(let j = 0; j < ny; j++) for(let i = 0; i < nx; i++){
      const x = (W - (nx-1)*a)/2 + i*a + (j % 2 ? a/2 : 0) - a/4;
      host.push({ x, y: oy + j*h });
      if(j < ny-1) inter.push({ x: x + a/2, y: oy + j*h + h*(j % 2 ? 1/3 : 2/3) });
    }
    return { host, inter };
  }
  function layered(W, H, a){
    const host = [], inter = [];
    const nx = Math.floor(W / a) + 1;
    const ox = (W - (nx-1)*a)/2;
    const rows = []; let y = a*0.45, k = 0;
    while(y < H){ rows.push(y); y += (k % 2 === 1) ? a*1.55 : a*0.75; k++; }
    rows.forEach((yy, r) => { for(let i = 0; i < nx; i++) host.push({ x: ox + i*a + (r % 2 ? a/2 : 0), y: yy }); });
    for(let r = 1; r < rows.length - 1; r += 2){
      const gy = (rows[r] + rows[r+1]) / 2;
      for(let i = 0; i < nx; i++) inter.push({ x: ox + i*a + a/4, y: gy });
    }
    return { host, inter };
  }
  function amorphous(W, H, a, n){
    const host = []; let tries = 0;
    while(host.length < n && tries < 20000){
      tries++;
      const p = { x: rnd(0, W), y: rnd(0, H) };
      if(host.every(q => (q.x-p.x)**2 + (q.y-p.y)**2 > (a*0.62)**2)) host.push(p);
    }
    const inter = [];
    for(let t = 0; t < 4000 && inter.length < n; t++){
      const p = { x: rnd(0, W), y: rnd(0, H) };
      let dmin = 1e9; for(const q of host){ const d = (q.x-p.x)**2 + (q.y-p.y)**2; if(d < dmin) dmin = d; }
      if(dmin > (a*0.42)**2 && inter.every(q => (q.x-p.x)**2 + (q.y-p.y)**2 > (a*0.5)**2)) inter.push(p);
    }
    return { host, inter };
  }
  // pick exactly n points from a list, preferring an even spread, then order them row-major for smooth morphing
  function fitCount(pts, n, W, H, random){
    let out = pts.slice();
    if(out.length > n && random){ shuffle(out); out = out.slice(0, n); }
    if(out.length > n){
      // drop the points closest to (or beyond) the edges first, so no holes appear inside the picture
      const edgeDist = p => Math.min(p.x, W - p.x, p.y, H - p.y);
      out.sort((p, q) => edgeDist(q) - edgeDist(p));
      out = out.slice(0, n);
    }
    while(out.length < n) out.push({ x: rnd(-40, W+40), y: rnd(-40, H+40), ghost: true });
    return out;
  }
  function order(pts, a){ return pts.slice().sort((p, q) => (Math.round(p.y/(a*0.9)) - Math.round(q.y/(a*0.9))) || (p.x - q.x)); }

  // 2-B. structure space through noise: noise -> structure k (denoise) -> hold with interstitial hops -> noise -> structure k+1
  SIMS.combo = function(W, H){
    const a = W < 420 ? 40 : 46;
    const inb = p => p.x > 4 && p.x < W - 4 && p.y > 4 && p.y < H - 4;
    const gens = [squareLattice(W, H, a), hexLattice(W, H, a*1.05), layered(W, H, a), null];
    const nHost = Math.min(...gens.slice(0, 3).map(g => g.host.length));
    gens[3] = amorphous(W, H, a, nHost);
    const nLi = Math.round(nHost * 0.2);
    const structs = gens.map(g => ({ host: fitCount(g.host, nHost, W, H), sites: g.inter.filter(inb) }));
    const hosts = Array.from({ length: nHost }, () => ({ nx: 0, ny: 0, tx: 0, ty: 0, ph: rnd(0, 6.28), f: rnd(0.7, 1.3) }));
    const ions = Array.from({ length: nLi }, () => ({ nx: 0, ny: 0, from: 0, to: 0, p: 1, glow: 0, ph: rnd(0, 6.28), f: rnd(0.7, 1.3) }));
    let k = -1, t = 0, occ = [];
    const T_DEN = 3.6, T_HOLD = 4.6, T_NOISE = 1.4, T_REST = 0.5, PERIOD = T_DEN + T_HOLD + T_NOISE + T_REST;
    function newNoise(){ for(const q of hosts.concat(ions)){ q.nx = rnd(-10, W + 10); q.ny = rnd(-10, H + 10); } }
    function nextStruct(){
      k = (k + 1) % structs.length;
      const S = structs[k];
      const hs = shuffle(S.host.slice());
      hosts.forEach((h, i) => { h.tx = hs[i].x; h.ty = hs[i].y; });
      const pick = shuffle(S.sites.map((_, i) => i)).slice(0, nLi);
      occ = S.sites.map(() => false);
      ions.forEach((ion, i) => { ion.from = ion.to = pick[i]; ion.p = 1; ion.glow = 0; occ[pick[i]] = true; });
    }
    newNoise(); nextStruct();
    function level(){
      if(t < T_DEN) return ease(t / T_DEN);
      if(t < T_DEN + T_HOLD) return 1;
      if(t < T_DEN + T_HOLD + T_NOISE) return 1 - ease((t - T_DEN - T_HOLD) / T_NOISE);
      return 0;
    }
    function sitePos(ion){ const S = structs[k].sites, A = S[ion.from], B = S[ion.to]; const e = ion.p < 1 ? (1 - Math.cos(Math.PI*ion.p))/2 : 1; return { x: A.x + (B.x - A.x)*e, y: A.y + (B.y - A.y)*e }; }
    return {
      step(dt){
        const was = t; t += dt;
        if(was < T_DEN + T_HOLD && t >= T_DEN + T_HOLD) newNoise();      // fresh noise target for the way out
        if(t >= PERIOD){ t -= PERIOD; nextStruct(); }
        const holding = t >= T_DEN && t < T_DEN + T_HOLD - 0.6;
        const S = structs[k].sites;
        for(const ion of ions){
          ion.glow = Math.max(0, ion.glow - dt/1.1);
          if(ion.p < 1){ ion.p = Math.min(1, ion.p + dt/0.45); if(ion.p >= 1){ occ[ion.from] = false; ion.from = ion.to; } continue; }
          if(holding && Math.random() < dt*0.35){
            const P = S[ion.from];
            const cand = [];
            for(let j = 0; j < S.length; j++) if(!occ[j] && j !== ion.from){ const d = (S[j].x - P.x)**2 + (S[j].y - P.y)**2; if(d < (a*1.0)**2) cand.push(j); }
            if(cand.length){ const to = cand[(Math.random()*cand.length)|0]; occ[to] = true; ion.to = to; ion.p = 0; ion.glow = 1; }
          }
        }
      },
      draw(ctx, time){
        const s = reduce ? 1 : level();
        const jit = (1 - s) * a * 0.5, vib = 0.4 + s * 0.9;
        const hp = hosts.map(h => ({
          x: h.nx*(1-s) + h.tx*s + jit*Math.sin(time*0.0021*h.f + h.ph) + vib*Math.sin(time*0.004 + h.ph),
          y: h.ny*(1-s) + h.ty*s + jit*Math.cos(time*0.0019*h.f + h.ph*1.3) + vib*Math.cos(time*0.0037 + h.ph),
        }));
        const ip = ions.map(ion => { const P = sitePos(ion); return {
          x: ion.nx*(1-s) + P.x*s + jit*Math.sin(time*0.0023*ion.f + ion.ph),
          y: ion.ny*(1-s) + P.y*s + jit*Math.cos(time*0.002*ion.f + ion.ph*1.3) }; });
        drawEdges(ctx, hp, a*1.12, 0.07 + 0.18*s, 1);
        ions.forEach((ion, i) => {
          if(ion.glow <= 0.01) return;
          const P = ip[i];
          ctx.strokeStyle = C.amber; ctx.lineWidth = 1.6; ctx.globalAlpha = 0.75*ion.glow*s; ctx.beginPath();
          for(const h of hp){ if((h.x-P.x)**2 + (h.y-P.y)**2 < (a*1.2)**2){ ctx.moveTo(P.x, P.y); ctx.lineTo(h.x, h.y); } }
          ctx.stroke(); ctx.globalAlpha = 1;
        });
        for(const h of hp) circle(ctx, h.x, h.y, a*0.17, C.node);
        for(const P of ip) circle(ctx, P.x, P.y, a*0.12, C.amber, 0.4 + 0.6*s);
        ctx.globalAlpha = 0.25; ctx.fillStyle = C.ink; ctx.fillRect(14, H - 13, W - 28, 1);
        ctx.globalAlpha = 0.95; ctx.fillStyle = C.amber; ctx.fillRect(14, H - 14, (W - 28)*(1 - s), 3); ctx.globalAlpha = 1;
      }
    };
  };


  const root = document.querySelector('.genlat');
  if (root) {
    const cv = root.querySelector('canvas');
    const ctx = cv.getContext('2d');
    let sim = null, W = 0, H = 0, running = false, raf = 0, last = 0;
    function setup(){
      const r = cv.getBoundingClientRect(); const dpr = Math.min(window.devicePixelRatio || 1, 2);
      W = r.width; H = r.height; if (W < 10 || H < 10) return;
      cv.width = Math.round(W*dpr); cv.height = Math.round(H*dpr); ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      sim = SIMS.combo(W, H);
      if (reduce) { for (let i = 0; i < 90; i++) sim.step(0.05); frame(4000); }
    }
    function frame(time){ ctx.clearRect(0, 0, W, H); sim.draw(ctx, time); }
    function loop(t){ const dt = Math.min(0.05, (t - last)/1000); last = t; sim.step(dt); frame(t); if (running) raf = requestAnimationFrame(loop); }
    setup();
    if (!reduce && sim) {
      for (let i = 0; i < 50; i++) sim.step(0.05);   // start partway into the first denoising pass
      frame(performance.now());
      new IntersectionObserver((es) => {
        const vis = es[0].isIntersecting;
        if (vis && !running) { running = true; last = performance.now(); raf = requestAnimationFrame(loop); }
        if (!vis) { running = false; cancelAnimationFrame(raf); }
      }).observe(cv);
    }
    let rt = 0;
    window.addEventListener('resize', () => { clearTimeout(rt); rt = setTimeout(() => { const was = running; running = false; cancelAnimationFrame(raf); setup(); if (was && !reduce) { running = true; last = performance.now(); raf = requestAnimationFrame(loop); } }, 150); });
  }
})();
</script>
