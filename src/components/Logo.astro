---
// Lab logo drawn inline so the charcoal parts follow the text color (works in dark mode).
const { size = 34 } = Astro.props;
---
<svg viewBox="0 0 120 120" width={size} height={size} aria-hidden="true">
  <g stroke="currentColor" stroke-linecap="round" fill="none">
    <line x1="28" y1="30" x2="18" y2="88" stroke-width="0.8" opacity="0.18"/>
    <line x1="95" y1="28" x2="18" y2="88" stroke-width="0.8" opacity="0.15"/>
    <line x1="102" y1="72" x2="18" y2="88" stroke-width="0.8" opacity="0.2"/>
    <line x1="28" y1="30" x2="75" y2="103" stroke-width="0.8" opacity="0.18"/>
    <line x1="28" y1="30" x2="95" y2="28" stroke-width="1" opacity="0.3"/>
    <line x1="95" y1="28" x2="75" y2="103" stroke-width="1" opacity="0.3"/>
    <line x1="28" y1="30" x2="102" y2="72" stroke-width="0.9" opacity="0.25"/>
    <line x1="75" y1="103" x2="18" y2="88" stroke-width="1" opacity="0.32"/>
    <line x1="102" y1="72" x2="75" y2="103" stroke-width="1.1" opacity="0.35"/>
    <line x1="95" y1="28" x2="102" y2="72" stroke-width="1.4" opacity="0.5"/>
    <line x1="58" y1="60" x2="18" y2="88" stroke-width="1.3" opacity="0.45"/>
    <line x1="58" y1="60" x2="75" y2="103" stroke-width="1.5" opacity="0.55"/>
    <line x1="58" y1="60" x2="95" y2="28" stroke-width="2" opacity="0.75"/>
  </g>
  <line x1="58" y1="60" x2="28" y2="30" stroke="#f59e0b" stroke-width="3" stroke-linecap="round" opacity="0.85"/>
  <line x1="58" y1="60" x2="102" y2="72" stroke="#f59e0b" stroke-width="3.6" stroke-linecap="round"/>
  <g fill="currentColor">
    <circle cx="28" cy="30" r="6"/><circle cx="95" cy="28" r="6"/><circle cx="102" cy="72" r="6"/>
    <circle cx="75" cy="103" r="6"/><circle cx="18" cy="88" r="6"/>
  </g>
  <circle cx="58" cy="60" r="14" fill="#f59e0b" opacity="0.2"/>
  <circle cx="58" cy="60" r="9" fill="#f59e0b"/>
</svg>
