---
// Front-page animation: atoms of a crystal (left, ordered) turn into a graph (right, disordered).
// Atoms are nodes, neighbors within a cutoff are edges, and orange pulses pass messages along
// the edges, as in a graph neural network / machine-learning interatomic potential.
const { height = 440 } = Astro.props;
---
<div class="atomgraph" style={`--h:${height}px`}>
  <canvas role="img" aria-label="Animation: atoms in a crystal connected as a graph, with signals passing between neighboring atoms"></canvas>
</div>

<style>
  .atomgraph { position: relative; width: 100%; height: var(--h); max-height: 75vw; border-radius: var(--radius); overflow: hidden; background: var(--soft); }
  canvas { width: 100%; height: 100%; display: block; }
</style>

<script>
  type Node = { bx: number; by: number; x: number; y: number; ph: number; amp: number; act: number; nb: number[] };
  type Pulse = { from: number; to: number; t: number; depth: number };

  function start(root: HTMLElement) {
    const canvas = root.querySelector('canvas') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let W = 0, H = 0, a = 46;
    let nodes: Node[] = [];
    let pulses: Pulse[] = [];
    let col = { node: '#cbd2db', edge: '#9aa3b2', amber: '#f59e0b' };

    function readColors() {
      const cs = getComputedStyle(document.documentElement);
      col = {
        node: cs.getPropertyValue('--lattice').trim() || col.node,
        edge: cs.getPropertyValue('--ink-3').trim() || col.edge,
        amber: cs.getPropertyValue('--amber').trim() || col.amber,
      };
    }

    const smooth = (e0: number, e1: number, x: number) => {
      const t = Math.min(1, Math.max(0, (x - e0) / (e1 - e0)));
      return t * t * (3 - 2 * t);
    };

    function build() {
      const r = canvas.getBoundingClientRect();
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      W = r.width; H = r.height;
      canvas.width = Math.round(W * dpr); canvas.height = Math.round(H * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      a = W < 500 ? 40 : 48;
      const nx = Math.ceil(W / a) + 2, ny = Math.ceil(H / a) + 2;
      const ox = (W - (nx - 1) * a) / 2, oy = (H - (ny - 1) * a) / 2;
      nodes = [];
      for (let j = 0; j < ny; j++) for (let i = 0; i < nx; i++) {
        const bx0 = ox + i * a, by0 = oy + j * a;
        const d = smooth(0.25, 0.95, bx0 / W);          // 0 on the left (crystal), 1 on the right (graph)
        const bx = bx0 + (Math.random() - 0.5) * a * 0.9 * d;
        const by = by0 + (Math.random() - 0.5) * a * 0.9 * d;
        nodes.push({ bx, by, x: bx, y: by, ph: Math.random() * 6.28, amp: 0.8 + 2.2 * d, act: 0, nb: [] });
      }
      const rc = a * 1.5;
      for (let p = 0; p < nodes.length; p++) for (let q = p + 1; q < nodes.length; q++) {
        const dx = nodes[p].bx - nodes[q].bx, dy = nodes[p].by - nodes[q].by;
        if (dx * dx + dy * dy < rc * rc) { nodes[p].nb.push(q); nodes[q].nb.push(p); }
      }
      pulses = [];
    }

    function fire() {
      // start a message-passing wave from a random node
      const s = (Math.random() * nodes.length) | 0;
      nodes[s].act = 1;
      for (const q of nodes[s].nb) if (Math.random() < 0.7) pulses.push({ from: s, to: q, t: 0, depth: 1 });
    }

    function step(dt: number) {
      for (const n of nodes) n.act = Math.max(0, n.act - dt / 1.4);
      const next: Pulse[] = [];
      for (const p of pulses) {
        p.t += dt / 0.45;
        if (p.t >= 1) {
          const n = nodes[p.to];
          n.act = 1;
          if (p.depth < 3) for (const q of n.nb) if (q !== p.from && Math.random() < 0.35) next.push({ from: p.to, to: q, t: 0, depth: p.depth + 1 });
        } else next.push(p);
      }
      pulses = next.length > 400 ? next.slice(-400) : next;
    }

    let timer = 0;
    function draw(time: number) {
      ctx.clearRect(0, 0, W, H);
      for (const n of nodes) {
        n.x = n.bx + (reduce ? 0 : n.amp * Math.sin(time * 0.0011 + n.ph));
        n.y = n.by + (reduce ? 0 : n.amp * Math.cos(time * 0.0009 + n.ph * 1.7));
      }
      // edges
      ctx.lineWidth = 1;
      ctx.strokeStyle = col.edge;
      ctx.globalAlpha = 0.16;
      ctx.beginPath();
      for (let p = 0; p < nodes.length; p++) for (const q of nodes[p].nb) if (q > p) {
        ctx.moveTo(nodes[p].x, nodes[p].y); ctx.lineTo(nodes[q].x, nodes[q].y);
      }
      ctx.stroke();
      // active edges and pulses
      ctx.globalAlpha = 1;
      ctx.strokeStyle = col.amber; ctx.fillStyle = col.amber;
      for (const p of pulses) {
        const A = nodes[p.from], B = nodes[p.to];
        const px = A.x + (B.x - A.x) * p.t, py = A.y + (B.y - A.y) * p.t;
        ctx.globalAlpha = 0.55; ctx.lineWidth = 2;
        ctx.beginPath(); ctx.moveTo(A.x, A.y); ctx.lineTo(px, py); ctx.stroke();
        ctx.globalAlpha = 1;
        ctx.beginPath(); ctx.arc(px, py, 2.6, 0, Math.PI * 2); ctx.fill();
      }
      // nodes
      for (const n of nodes) {
        const r = a * 0.1 + n.act * a * 0.06;
        ctx.globalAlpha = 1;
        ctx.fillStyle = col.node;
        ctx.beginPath(); ctx.arc(n.x, n.y, r, 0, Math.PI * 2); ctx.fill();
        if (n.act > 0.02) {
          ctx.globalAlpha = n.act;
          ctx.fillStyle = col.amber;
          ctx.beginPath(); ctx.arc(n.x, n.y, r, 0, Math.PI * 2); ctx.fill();
        }
      }
      ctx.globalAlpha = 1;
    }

    let last = performance.now(), running = true, raf = 0;
    function loop(t: number) {
      const dt = Math.min(0.05, (t - last) / 1000); last = t;
      timer -= dt;
      if (timer <= 0) { fire(); timer = 0.7 + Math.random() * 0.6; }
      step(dt); draw(t);
      if (running) raf = requestAnimationFrame(loop);
    }

    readColors(); build();
    if (reduce) {
      for (let k = 0; k < 4; k++) fire();
      for (let k = 0; k < 14; k++) step(0.05);
      draw(0);
    } else {
      for (let k = 0; k < 3; k++) { fire(); step(0.3); }
      const io = new IntersectionObserver((es) => {
        const vis = es[0].isIntersecting;
        if (vis && !running) { running = true; last = performance.now(); raf = requestAnimationFrame(loop); }
        if (!vis) { running = false; cancelAnimationFrame(raf); }
      });
      io.observe(root);
      raf = requestAnimationFrame(loop);
    }
    let rt = 0;
    window.addEventListener('resize', () => { clearTimeout(rt); rt = window.setTimeout(() => { build(); if (reduce) draw(0); }, 150); });
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => { readColors(); if (reduce) draw(0); });
  }
  document.querySelectorAll<HTMLElement>('.atomgraph').forEach(start);
</script>
